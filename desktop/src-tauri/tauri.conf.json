{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snipvoice Manager",
  "mainBinaryName": "snipvoice-manager",
  "version": "1.3.0",
  "identifier": "io.github.rteoo.snipvoice.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snipvoice",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "backgroundColor": "#292929"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
